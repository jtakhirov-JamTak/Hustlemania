# Example environment file. This is the only non-secret env file in the repo, and it
# carries no leading dot on purpose: every `.env*` is treated as secret by .gitignore,
# by `.claude/settings.json` permissions.deny, and by the user-level shell guard
# (handoff B3). Copy this to `.env` and fill in real values. Never commit `.env`.
#
# Values are intentionally empty. A filled-in value here would be a committed secret.

# Base URL of the Supabase project. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. Safe to expose — RLS is what protects the data,
# not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SECRET: it bypasses RLS entirely. Server-side only, and
# never in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by migrations and local tooling. SECRET.
DATABASE_URL=

# F13 evening reminder (docs/RUNBOOK_REMINDERS.md).
# Bearer the database's hourly job presents to POST /api/cron/reminders. SECRET. The
# same value goes into the Supabase Vault as `reminders_secret`. Locally,
# scripts/local-env.mjs derives one and writes it to .env.local.
CRON_SECRET=

# Resend API key. SECRET. Unset outside production = the log transport (nothing sent);
# unset in production = the route answers 503 and sends nothing.
RESEND_API_KEY=

# Sender for reminders, on a domain verified in Resend, e.g. "Sprint <sprint@example.com>".
REMINDER_FROM=

# F17 capture parser (docs/SPEC.md F17). Anthropic API key. SECRET. Server-side only.
# Unset = every one-box capture answers "Sorting is unavailable — fill the parts by
# hand." and the app keeps working with typed parts. The build checks the name only.
ANTHROPIC_API_KEY=

# Not a variable to set here: PARSE_STUB=1 makes the parser answer with the keyword
# splitter (lib/capture.ts) — Playwright sets it for its dev server, and
# `node scripts/local-env.mjs --e2e` writes it to .env.local. A hosted build with it
# set is refused by scripts/check-build-env.mjs.
